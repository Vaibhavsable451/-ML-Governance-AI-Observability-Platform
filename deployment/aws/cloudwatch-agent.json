{
  "agent": {"metrics_collection_interval": 60},
  "metrics": {
    "namespace": "AIGovernance/EC2",
    "append_dimensions": {"InstanceId": "${aws:InstanceId}"},
    "metrics_collected": {
      "mem": {"measurement": ["mem_used_percent"]},
      "disk": {"measurement": ["used_percent"], "resources": ["/"]},
      "cpu": {"measurement": ["cpu_usage_user", "cpu_usage_system"], "totalcpu": true}
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/containers/api-*.log", "log_group_name": "/ai-governance/api", "log_stream_name": "{instance_id}"},
          {"file_path": "/var/log/containers/streamlit-*.log", "log_group_name": "/ai-governance/streamlit", "log_stream_name": "{instance_id}"}
        ]
      }
    }
  }
}
