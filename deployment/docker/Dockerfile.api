FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app DATA_DIR=/data
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN pip install --no-cache-dir --prefer-binary --default-timeout=1000 --retries 20 -r requirements.txt
RUN useradd -m -u 1000 app && mkdir -p /data && chown app /data
COPY --chown=app:app core core
COPY --chown=app:app ml ml
COPY --chown=app:app agents agents
COPY --chown=app:app rag rag
COPY --chown=app:app monitoring monitoring
COPY --chown=app:app backend backend
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s CMD curl -fs http://localhost:8000/health || exit 1
CMD ["uvicorn", "backend.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
